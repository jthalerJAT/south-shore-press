# Copy this file to .env.local and fill in real values.
# Same Supabase project as v1 — just different env var names (Next.js
# convention requires the NEXT_PUBLIC_ prefix for browser-visible values).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: only needed if you add server-only Supabase calls that need to
# bypass RLS (e.g. admin tooling). Keep secret — DO NOT commit.
# SUPABASE_SERVICE_ROLE_KEY=

# Site origin — used for password-reset redirect URLs + sitemap absolute URLs.
# Production: https://south-shore-press.vercel.app (or the custom domain post-cutover)
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Stripe (optional — required only if you want payment-method capture
# on /signup and /account → Payment to work). If unset, the card UI is
# hidden and /api/payments/* returns 503. Get a fresh test pair from
# https://dashboard.stripe.com/test/apikeys for the SSP Stripe account.
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# ---------------------------------------------------------------------
# Resend (optional — powers the Legals "Request Notarized Copy" email).
# If unset, the request is still saved; the email is just skipped. The
# sender domain must be verified in Resend (southshorepress.com).
# ---------------------------------------------------------------------
# RESEND_API_KEY=
# LEGALS_FROM_EMAIL=The South Shore Press <legals@southshorepress.com>
# LEGALS_NOTIFY_EMAIL=legals@southshorepress.com

# ---------------------------------------------------------------------
# InDesign export (Phase 7). Shared token the UXP plugin sends as the
# `x-ssp-print-token` header to read /api/print/*. If unset, those routes
# return 503. Use a long random string; paste the same value into the plugin.
# Reading also requires SUPABASE_SERVICE_ROLE_KEY (above) to be set.
# ---------------------------------------------------------------------
# INDESIGN_API_TOKEN=

# ---------------------------------------------------------------------
# X / Twitter (optional — powers "Publish Tweet" in the Social Media tile).
# If unset, editors can still compose but publishing is disabled. Create an
# app at https://developer.twitter.com for the @southshorepress account, set
# its user-auth permissions to **Read and Write**, then generate the four
# OAuth 1.0a user-context keys below (app-only bearer tokens can't post).
# ---------------------------------------------------------------------
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# ---------------------------------------------------------------------
# Constant Contact (optional — powers the Email Briefings sign-up form,
# which pushes contacts onto a CC list). CC API v3 uses OAuth2; the app
# credentials go here, the rotating user tokens live in the DB
# (constant_contact_oauth, migration 019). After setting these, an admin
# connects once by visiting /api/constant-contact/connect. The CC app's
# redirect URI must be <site>/api/constant-contact/callback.
# ---------------------------------------------------------------------
# CONSTANT_CONTACT_CLIENT_ID=
# CONSTANT_CONTACT_CLIENT_SECRET=
# CONSTANT_CONTACT_LIST_ID=
