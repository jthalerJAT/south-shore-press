# Copy this file to .env.local and fill in real values.
# Same Supabase project as v1 — just different env var names (Next.js
# convention requires the NEXT_PUBLIC_ prefix for browser-visible values).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: only needed if you add server-only Supabase calls that need to
# bypass RLS (e.g. admin tooling). Keep secret — DO NOT commit.
# SUPABASE_SERVICE_ROLE_KEY=

# Site origin — used for password-reset redirect URLs + sitemap absolute URLs.
# Production: https://south-shore-press.vercel.app (or the custom domain post-cutover)
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Stripe (optional — required only if you want payment-method capture
# on /signup and /account → Payment to work). If unset, the card UI is
# hidden and /api/payments/* returns 503. Get a fresh test pair from
# https://dashboard.stripe.com/test/apikeys for the SSP Stripe account.
# ---------------------------------------------------------------------
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# ---------------------------------------------------------------------
# Resend (optional — powers the Legals "Request Notarized Copy" email).
# If unset, the request is still saved; the email is just skipped. The
# sender domain must be verified in Resend (southshorepress.com).
# ---------------------------------------------------------------------
# RESEND_API_KEY=
# LEGALS_FROM_EMAIL=The South Shore Press <legals@southshorepress.com>
# LEGALS_NOTIFY_EMAIL=legals@southshorepress.com
